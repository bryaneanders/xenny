<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>xenny</groupId>
    <artifactId>xenny</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <!-- No code: collects Kafka Connect plugins into target/plugins for the Connect image. -->
  <artifactId>connect</artifactId>
  <packaging>pom</packaging>

  <properties>
    <iceberg.version>1.12.0</iceberg.version>
  </properties>

  <!-- Iceberg sink. Iceberg doesn't publish a ready-made bundle, so list what it needs here. -->
  <dependencies>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-kafka-connect</artifactId>
      <version>${iceberg.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-parquet</artifactId>
      <version>${iceberg.version}</version>
    </dependency>
    <!-- S3FileIO, plus the AWS SDK it uses. -->
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws</artifactId>
      <version>${iceberg.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.iceberg</groupId>
      <artifactId>iceberg-aws-bundle</artifactId>
      <version>${iceberg.version}</version>
    </dependency>
    <!-- The Parquet writer needs Hadoop's Configuration class. -->
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.hadoop</groupId>
      <artifactId>hadoop-client-runtime</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>iceberg</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <!-- Connect provides these. -->
              <excludeGroupIds>org.apache.kafka,org.slf4j</excludeGroupIds>
              <outputDirectory>${project.build.directory}/plugins/iceberg</outputDirectory>
            </configuration>
          </execution>
          <!-- Converter that decodes our Avro messages using the schema registry. -->
          <execution>
            <id>apicurio</id>
            <phase>package</phase>
            <goals><goal>unpack</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.apicurio</groupId>
                  <artifactId>apicurio-registry-distro-connect-converter</artifactId>
                  <version>${apicurio.version}</version>
                  <type>tar.gz</type>
                </artifactItem>
              </artifactItems>
              <!-- Replaced below with a version that has a security fix. -->
              <excludes>netty-handler-4.*.jar</excludes>
              <outputDirectory>${project.build.directory}/plugins/apicurio</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>apicurio-netty</id>
            <phase>package</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.netty</groupId>
                  <artifactId>netty-handler</artifactId>
                  <version>4.1.139.Final</version>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.build.directory}/plugins/apicurio</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
